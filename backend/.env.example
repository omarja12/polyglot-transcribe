# Copy this file to backend/.env and fill in your GROQ_API_KEY. DO NOT commit real keys.
# Minimal required setting:
GROQ_API_KEY=

# Optional overrides (use only if you want a different model than the defaults in code):
# Set the primary report model to one your Groq account can access (example: qwen/qwen3.6-27b)
GROQ_REPORT_MODEL=qwen/qwen3.6-27b
# Optional fallback model used if the primary fails
GROQ_FALLBACK_REPORT_MODEL=groq/compound
# Transcription model (defaults to whisper-large-v3)
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# CORS: comma-separated list of allowed origins for the frontend (defaults to '*')
ALLOWED_ORIGINS=http://localhost:3000

# Notes:
#  - Do not include your API key in public repositories.
#  - After creating backend/.env with your key, restart the backend server:
#      cd backend
#      uvicorn main:app --reload --port 8000
